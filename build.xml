<?xml version="1.0" encoding="UTF-8"?>

<project name="mangapress" default="build">

	<!-- ============================================  -->
	<!-- Target: prepare                               -->
	<!-- ============================================  -->
	<target name="prepare">
		<echo msg="Making directory ./build/current/mangapress" />
		<mkdir dir="./build/current/mangapress" />
	</target>

	<!-- ============================================  -->
	<!-- Target: build                                 -->
	<!-- ============================================  -->
	<target name="build" depends="prepare">
		<echo msg="Copying files to build directory..." />

		<echo msg="Copying files to ./build/current/mangapress directory..." />
		<copy todir="./build/current/mangapress" includeemptydirs="true" >
			<fileset dir="." defaultexcludes="true">
				<exclude name="build/**" />
				<exclude name="vendor/**" />
				<exclude name=".git/**" />
				<exclude name=".idea/**" />
				<exclude name=".gitignore" />
				<exclude name=".editorconfig" />
				<exclude name="*.xml" />
				<exclude name="composer.lock" />
				<exclude name="README.md" />
			</fileset>
		</copy>

		<echo msg="Running composer install --no-dev in build directory" />
		<exec executable="composer" dir="build/current/mangapress" passthru="yes">
			<arg value="install"/>
			<arg value="--no-dev"/>
		</exec>

		<echo msg="Remove composer files..." />
		<exec executable="rm" dir="build/current/mangapress" passthru="yes">
			<arg value="composer.*" />
		</exec>
	</target>

	<!-- ============================================  -->
	<!-- (DEFAULT)  Target: dist                       -->
