{
    "name": "mangapress/mangapress",
    "description": "Manga+Press is a webcomic management system for WordPress. Manga+Press uses WordPress' posts, pages and categories to help you keep track of your comic posts. Manga+Press also src its own custom template tags to help make creating themes easier.",
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.1",
        "phing/phing": "^2.17"
    },
    "license": "GPL2",
    "authors": [
        {
            "name": "Jess Green"
        }
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
      "files": [
        "src/classes/trait-singleton.php",
        "src/classes/form/class-element.php",
        "src/classes/form/element/class-checkbox.php",
        "src/classes/form/element/class-radio.php",
        "src/classes/form/element/class-select.php",
        "src/classes/form/element/class-text.php",
        "src/classes/form/element/class-textarea.php",
        "src/classes/class-contenttype.php",
        "src/classes/class-posttype.php",
        "src/classes/class-taxonomy.php",
        "src/query.php",
        "src/latestcomic-functions.php",
        "src/comicarchive-functions.php",
        "src/latestcomic-template-handlers.php",
        "src/comicarchive-template-handlers.php",
        "src/functions.php",
        "src/deprecated-functions.php",
        "src/template-functions.php",
        "src/classes/class-settings.php",
        "src/classes/class-install.php",
        "src/classes/class-admin.php",
        "src/classes/class-options.php",
        "src/classes/class-posts.php",
        "src/classes/class-bootstrap.php"
      ]
    }
}
